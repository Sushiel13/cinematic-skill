# Render settings for this film. render-film.sh reads them; anything filled in on "Run workflow" wins.
VOICE=piper
PIPER_VOICE=hi_IN-pratham-medium
PIPER_FALLBACK="hi_IN-rohan-medium hi_IN-priyamvada-medium"
# a deeper, slower read: pitch factor (1.0 = natural voice) and pace (>1 = slower)
VOICE_PITCH=0.88
VOICE_PACE=1.25
CAPTIONS=highlighter
SIZE=1920x1080
# fit the film to 90 seconds (the read is stretched or tightened by at most 10-15%)
TARGET=90
# Draft first: only the first 30 seconds. Delete this line (or leave it empty) for the full film.
PREVIEW=30
# score levels: felt under the voice, ducked while the narrator speaks
MIX_ARGS="--music-db -3 --sfx-db -4 --duck-ratio 3 --duck-threshold 0.03 --music-eq-dip 3"
LABEL="FAN-MADE TRIBUTE · NOT OFFICIAL FOOTAGE"
# thumbnail: the final title card, 3.4 s before the end
THUMB_T=-3.4
# video quality: 20 keeps the grain and halves the file size
CRF=20
